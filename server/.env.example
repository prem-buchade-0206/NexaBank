# ---- Application ----
APP_NAME=NexaBank Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database ----
# replicaSet=rs0 is required in production/docker-compose because the
# Transactions module uses real MongoDB multi-document transactions, which
# only work against a replica set (even a single-node one). If you're
# running a plain standalone mongod for quick local scripts that never touch
# money-movement endpoints, you can drop the query string.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=nexabank

# ---- Redis (optional) ----
REDIS_URI=redis://localhost:6379/0

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-generated-32-byte-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nexabank

# ---- Password Policy ----
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ---- Rate Limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true
